# Configuração de Conexão com o Turso (SQLite Cloud)
# Obtenha estas credenciais no painel do Turso (https://turso.tech) ou via CLI (turso db show / turso db tokens create)

TURSO_DATABASE_URL=libsql://seu-banco-seu-usuario.turso.io
TURSO_AUTH_TOKEN=seu_token_de_autenticacao_aqui

# Porta do servidor (opcional, padrão 3000 ou injetada pelo Render)
PORT=3000
